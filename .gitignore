# Vendored Windows portable Python runtime (relocated to build/windows-portable/)
build/

# PyInstaller output (packaging/build_dist.py) - a full native build,
# regenerated on demand, not committed
/dist/
/release-assets/
# InstallBuilder output (packaging/installbuilder/reflow-installer.xml) -
# a multi-GB setup.exe, regenerated on demand, not committed
/installer/
# Root-level shortcut to dist/ReflowStudio/ReflowStudio.exe - bakes in an
# absolute local path, so it's machine-specific and never committed
/ReflowStudio.lnk

# Auto-downloaded model weights & tool caches (managed by core/integrity.py).
# Anchored to the repo root (leading /) - an unanchored "models/" previously
# matched ANY directory named models anywhere in the tree, which silently
# excluded core/Wav2Lip/models/ (real source code: wav2lip.py, conv.py,
# __init__.py) from git entirely. A fresh clone would have been missing
# the file inference.py imports Wav2Lip from and crashed immediately -
# found while auditing the vendored Wav2Lip tree for dead files.
/models/
/ffmpeg/
/gfpgan/
core/Wav2Lip/checkpoints/
# MuseTalk's own checkpoints (its own UNet + sd-vae/whisper-tiny/
# face-parse-bisent auxiliaries - see
# core/providers/lipsync/musetalk_local.py) - same treatment as
# core/Wav2Lip/checkpoints/ above, real vendored source code in
# core/MuseTalk/ stays tracked, just not the multi-GB weights.
core/MuseTalk/models/

# Runtime-generated data
/temp/
core/Wav2Lip/temp/
core/MuseTalk/results/
core/MuseTalk/temp/
core/MuseTalk/_reflow_inference_config.yaml
/outputs/
/output/
debug_log.txt
*.tmp
settings.json
models.json
hardware_profile.json
ui_preferences.json
render_state.json
/queue_state.json
/queue_state.json.lock
/queue_state.json.corrupt-*.bak
graph.json

# Leftover Wav2Lip debug artifacts (regenerated per run)
core/Wav2Lip/temp_*.mp4
core/Wav2Lip/temp_*.wav

# Python
__pycache__/
*.pyc
*.pyo
reflow_venv/
*.egg-info/

# Frontend (Vite/React) - node_modules and dist are regenerated via
# `npm install && npm run build`, not committed
frontend/node_modules/
frontend/dist/

# OS cruft
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
.venv/
# Python tool caches regenerated by local checks
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Explicitly installed optional feature runtimes; rebuild from profile manifests.
/runtime_profiles/
